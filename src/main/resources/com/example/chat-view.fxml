<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ChatController">
    <TextField fx:id="messageInput" promptText="Skriv ett meddelande..."/>
    <Button text="Skicka till server" onAction="#handleSendMessage"/>
    <Button text="Lägg till lokalt" onAction="#handleLocalMessage"/>
</VBox>