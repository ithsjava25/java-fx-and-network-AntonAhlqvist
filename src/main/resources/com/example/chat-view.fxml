<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="com.example.ChatController"
      spacing="10"
      prefWidth="640" prefHeight="480"
      style="-fx-background-color: lightblue;">
    <StackPane fx:id="messageStack" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #f9e8aa; -fx-background-radius: 8;">
        <VBox fx:id="messageContainer"
              spacing="6"
              style="-fx-background-color: transparent;"
              StackPane.alignment="TOP_LEFT"/>
    </StackPane>
    <HBox spacing="10">
        <TextField fx:id="messageInput" VBox.vgrow="NEVER"/>
        <Button text="Skicka till server" onAction="#handleSendMessage"/>
        <Button text="Skicka inte till server" onAction="#handleLocalMessage"/>
    </HBox>
</VBox>