<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.HelloController">
    <VBox alignment="CENTER">
        <Label fx:id="messageLabel" text="Hello, JavaFX!" />
        <Label fx:id="currentDateTime" text="" />
        <Button fx:id="updateButton" text="Stop" onAction="#updateButtonAction"/>
        <Label fx:id="SecondDateTime" text="${controller.model.dateTime}"/>
        <CheckBox fx:id="toggle"/>
        <TextField fx:id="textFied1" disable="${toggle.selected}"/>
    </VBox>
</StackPane>