<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root"
           fx:controller="com.example.ChatetrisController"
           stylesheets="@style.css">

    <ImageView fx:id="backgroundImage"
               fitWidth="640" fitHeight="640"/>
    <Pane fx:id="messageLayer"
          layoutX="64" layoutY="64"
          prefWidth="512" prefHeight="448"
          StackPane.alignment="TOP_LEFT"
          pickOnBounds="false"/>
    <ImageView fx:id="frameImage"
               fitWidth="640" fitHeight="640"/>
    <AnchorPane
            prefHeight="160"
            StackPane.alignment="BOTTOM_CENTER">
        <TextField fx:id="messageInput"
                   promptText="Skriv max 45 tecken (kortare om tecknen är smala):"
                   AnchorPane.leftAnchor="64"
                   AnchorPane.rightAnchor="64"
                   AnchorPane.bottomAnchor="80"
                   style="-fx-text-fill: black;
                  -fx-prompt-text-fill: black;
                  -fx-font-family: 'Lucida Handwriting';
                  -fx-font-style: italic;"/>
        <Button text="Skapa lokalt tetrisblock!"
                onAction="#tbButton"
                AnchorPane.rightAnchor="64"
                AnchorPane.bottomAnchor="32"
                prefWidth="160"/>
        <Button fx:id="sendButton"
                text="Skicka meddelande till server"
                onAction="#handleSendAndTb"
                AnchorPane.leftAnchor="64"
                AnchorPane.bottomAnchor="32"
                prefWidth="160"/>
    </AnchorPane>
</StackPane>